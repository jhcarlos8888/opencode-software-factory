{
  "name": "factory-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel local para coordinar agentes OpenCode y Claude Code de OpenCode Software Factory.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.api.json && vite build",
    "start": "node dist-api/api/server.js",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:orchestration": "tsx --test src/api/orchestration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
